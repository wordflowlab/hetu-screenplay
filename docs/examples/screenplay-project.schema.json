        },
        "required": [
          "id",
          "kind",
          "parent_id",
          "title",
          "summary",
          "detail",
          "goal",
          "conflict",
          "turn",
          "start_state",
          "end_state",
          "archived",
          "formal_episode_id",
          "source_indices"
